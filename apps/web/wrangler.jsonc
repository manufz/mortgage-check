{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mortgage-check",
	"compatibility_date": "2026-08-19",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mortgage-check",
			"database_id": "44252d22-3e46-4787-9bda-94c840baa96b",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"env": {
		"staging": {
			"preview_urls": true,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "boilerplate-staging",
					"database_id": "local",
					"migrations_dir": "../../packages/db/migrations"
				}
			],
			"previews": {
				"d1_databases": [
					{
						"binding": "DB",
						"database_name": "PREVIEW_DB_NAME_PLACEHOLDER",
						"database_id": "PREVIEW_DB_ID_PLACEHOLDER"
					}
				]
			}
		}
	}
}